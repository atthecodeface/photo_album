{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    "rootDir": "./typescript/",
    "outDir": "../http/javascript/",

    "target": "es2017",

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",

    // "verbatimModuleSyntax": true,
    // "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "types": [
    ],
  },

  // "include": ["pkg/*"],

  "files": [
    "typescript/application.ts",
    "typescript/color.ts",
    "typescript/draw.ts",
    "typescript/html.ts",
    "typescript/animate.ts",
    "typescript/log.ts",
    "typescript/tabs.ts",
    "typescript/web_gl.ts",
    "typescript/web_gl_3d_obj.ts",
    "typescript/web_gl_flat.ts",
    "typescript/web_gl_pt_field.ts",

    "typescript/webgl_canvas.ts",

    "typescript/album_desc.ts",
    "typescript/layout_data.ts",
    "typescript/page_entry.ts",
    "typescript/page_layout.ts",

    "typescript/album.ts",
    "typescript/album_image.ts",
    "typescript/album_page.ts",
    "typescript/album_style.ts",
    "typescript/album_tab.ts",
    "typescript/panorama_tab.ts",
    "typescript/thumbnails_tab.ts",
    "typescript/photo_album.ts",

  ],
}
